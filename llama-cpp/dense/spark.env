# Spark-X2.5-4B - Q5_K_M community GGUF of XHToken/Spark-X2.5-4B
LLAMA_ARG_HF_REPO=abenzerps/Spark-X2.5-4B-GGUF
LLAMA_ARG_HF_FILE=Spark-X2.5-4B-Q5_K_M.gguf
LLAMA_ARG_ALIAS=spark-x2.5-4b

LLAMA_ARG_MMPROJ_AUTO=false
LLAMA_ARG_CTX_SIZE=8192
LLAMA_ARG_N_PREDICT=512
LLAMA_ARG_N_PARALLEL=1
LLAMA_ARG_THREADS=4
LLAMA_ARG_THREADS_BATCH=8
LLAMA_ARG_BATCH=1024
LLAMA_ARG_UBATCH=512
LLAMA_ARG_FLASH_ATTN=on
LLAMA_ARG_CONT_BATCHING=true

LLAMA_ARG_N_GPU_LAYERS=all
LLAMA_ARG_N_CPU_MOE=0
LLAMA_ARG_CPU_MOE=false
LLAMA_ARG_FIT=on
LLAMA_ARG_FIT_TARGET=512
LLAMA_ARG_FIT_CTX=8192

LLAMA_ARG_KV_OFFLOAD=true
LLAMA_ARG_CACHE_TYPE_K=f16
LLAMA_ARG_CACHE_TYPE_V=f16

LLAMA_ARG_CACHE_PROMPT=true
LLAMA_ARG_CACHE_RAM=4096
LLAMA_ARG_KV_UNIFIED=true
LLAMA_ARG_CACHE_IDLE_SLOTS=true
LLAMA_ARG_CTX_CHECKPOINTS=32
LLAMA_ARG_CHECKPOINT_MIN_SPACING_NT=8192

# Spark's embedded template requires Jinja.
LLAMA_ARG_JINJA=true
LLAMA_ARG_SKIP_CHAT_PARSING=false
LLAMA_ARG_REASONING=off
LLAMA_ARG_THINK_BUDGET=-1
LLAMA_ARG_PREFILL_ASSISTANT=true
LLAMA_ARG_SPEC_TYPE=none

LLAMA_ARG_OFFLINE=false

LLAMA_PUBLISHED_PORT=8081