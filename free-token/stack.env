# ============================================================
# IMAGE
# ============================================================

CUDA_IMAGE=nvidia/cuda:13.0.3-devel-ubuntu24.04
FREETOKEN_IMAGE=freetoken-local:latest

CONTAINER_NAME=freetoken
RESTART_POLICY=unless-stopped


# ============================================================
# MODEL
# ============================================================

MODEL=openai/gpt-oss-20b
SERVED_MODEL_NAME=gpt-oss-20b


# ============================================================
# SERVER
# ============================================================

FREETOKEN_HOST=0.0.0.0
FREETOKEN_PORT=1919

MAX_RUNNING_REQUESTS=1


# ============================================================
# CONTEXT / GENERATION
# ============================================================

MAX_SEQ_LEN=16384
MAX_OUTPUT_TOKENS=1024


# ============================================================
# VRAM / MOE
# ============================================================

# FreeToken puede usar aproximadamente esta fracción
# de la VRAM disponible al arrancar.
MEMORY_RATIO=0.75

# auto / offload / hybrid / cpu / fused
MOE_BACKEND=offload

# Reserva KV suficiente para nuestro contexto HA.
KV_RESERVE_TOKENS=16384


# ============================================================
# CACHE
# ============================================================

CACHE_TYPE=radix
CACHE_PATH=./cache


# ============================================================
# CONTAINER MEMORY
# ============================================================

MEM_LIMIT=20g
SHM_SIZE=2gb


# ============================================================
# NVIDIA
# ============================================================

NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# ============================================================
# HARDWARE BENCHMARK
# ============================================================

# if-missing = benchmark únicamente si no existe
# always     = recalibrar en cada deploy
# never      = no ejecutar automáticamente
BENCHMARK_MODE=if-missing
